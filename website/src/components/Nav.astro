---
interface Props { lang: 'en' | 'zh'; nav: { workflow: string; features: string; architecture: string; capabilities: string; download: string; github: string }; }
const { lang, nav } = Astro.props;
---
<nav class="site-nav"><div class="page-shell nav-inner"><a href={lang === 'en' ? '/en/' : '/'} class="nav-brand"><img src="/assets/app-icon.png" alt="" width="30" height="30" />ZeroWall Science</a><div class="nav-links"><a href="/docs/">{lang === "zh" ? "文档" : "Docs"}</a><a href="#workflow">{nav.workflow}</a><a href="#features">{nav.features}</a><a href="#architecture">{nav.architecture}</a><a href="#capabilities">{nav.capabilities}</a></div><div class="nav-actions"><a class="nav-github" href="https://github.com/ccfwwm/zerowallscience" target="_blank" rel="noreferrer">{nav.github}</a><a class="icon-button" title="Switch language" href={lang === 'en' ? '/' : '/en/'}>{lang === 'en' ? '中' : 'EN'}</a><button class="icon-button" id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">◐</button><a class="nav-download" href="#download">{nav.download}</a></div></div></nav>
<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => { const root = document.documentElement; const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; root.dataset.theme = next; localStorage.setItem('zw-theme', next); });
</script>
